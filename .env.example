# Copy to .env and adjust. Never commit a filled-in .env.

# Port Parlour listens on inside the container / on the host.
# Parlour's own ports (decided 2026-11-10, NOT Emby's 8096):
#   8585 = HTTP (main listener)   8586 = HTTPS, if served directly
PARLOUR_PORT=8585

# Postgres (docker-compose service)
POSTGRES_USER=parlour
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parlour

# Server settings (used once the server crate grows config loading)
# sslmode=disable suits the local docker Postgres; drop it for a
# managed Postgres that requires TLS.
PARLOUR_DATABASE_URL=postgres://parlour:change-me@db:5432/parlour?sslmode=disable
PARLOUR_MEDIA_PATH=/media
PARLOUR_LOG_LEVEL=info

# --- First admin (optional, one-time) ---
# When BOTH are set and no users exist yet, this account is created
# as the first admin at startup. Afterwards the variables are
# ignored — change the password in the app, not here.
# PARLOUR_ADMIN_USER=
# PARLOUR_ADMIN_PASSWORD=

# Set the Secure flag on the session cookie. Turn on (true) when
# Parlour sits behind the HTTPS reverse proxy in production; leave
# off for plain-HTTP access on the LAN/tailnet.
# PARLOUR_COOKIE_SECURE=false

# --- Metadata (Milestone 1.4) ---
# TMDB API key. Server .env only — never commit a real key.
# TMDB_API_KEY=
# TheTVDB API key (optional second provider, MD5).
# PARLOUR_TVDB_API_KEY=
# Local artwork cache directory inside the container.
# PARLOUR_ARTWORK_DIR=/artwork
# PARLOUR_CACHE_DIR=/cache
# PARLOUR_STREAM_SECRET= (optional; stream tokens survive restarts when set)

# Emby cutover import (Milestone 1.7) — read-only API key from Emby's
# dashboard (Advanced > API Keys). Only needed until the import is done.
# PARLOUR_EMBY_URL=http://emby-host:8096
# PARLOUR_EMBY_API_KEY=
